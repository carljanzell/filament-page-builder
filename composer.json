{
    "name": "carljanzell/filament-page-builder",
    "description": "A drag-and-drop visual page builder for Filament, storing content as ordered typed blocks.",
    "type": "library",
    "license": "proprietary",
    "authors": [
        {
            "name": "Carl Janzell",
            "email": "cnoropesa@up.edu.ph"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.27"
    },
    "autoload": {
        "psr-4": {
            "CarlJanzell\\FilamentPageBuilder\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CarlJanzell\\FilamentPageBuilder\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "CarlJanzell\\FilamentPageBuilder\\PageBuilderServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
